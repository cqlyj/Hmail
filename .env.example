# Copy to .env.local (gitignored). Never commit real values.
# Optional. The house fetches the desktop client from the web project when unset.
GOOGLE_CLIENT_ID=
# Optional. The house fetches the desktop client from the web project when unset.
GOOGLE_CLIENT_SECRET=
# Optional. Default is https://hmail-web.vercel.app.
HMAIL_WEB_ORIGIN=
# Only for web/dev-server.mjs. The deployed signer keeps its own copy.
WORLD_RP_SIGNING_KEY=
# Optional. Dev server and the issuer. Default is the public Sepolia RPC.
SEPOLIA_RPC_URL=
# Optional. Dev server and scripts/ens-issue.mjs only. Never commit a value.
HMAIL_REGISTRY_KEY=
